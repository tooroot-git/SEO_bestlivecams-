modules = ["python-3.9", "web", "java-graalvm22.3"]
[workflows]
runButton = "Run Server"

[[workflows.workflow]]
name = "Run Server"
author = 39044317

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python server.py"

[deployment]
run = ["sh", "-c", "python server.py"]

[[ports]]
localPort = 8080
externalPort = 80
